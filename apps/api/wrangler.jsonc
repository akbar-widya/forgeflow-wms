{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgeflow-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgeflow-wms",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "TRUSTED_ORIGINS": "https://forgeflow-web.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "forgeflow-prod",
          "database_id": "aa0326a6-d92f-4fb7-81e4-5b92d0e1d590",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  },
}
