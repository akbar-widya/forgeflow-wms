{
  "name": "@forgeflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply forgeflow-wms --local",
    "db:seed": "wrangler d1 execute forgeflow-wms --local --file=./src/seed.sql"
  },
  "dependencies": {
    "@forgeflow/contracts": "workspace:*",
    "@forgeflow/db": "workspace:*",
    "@hono/zod-validator": "^0.4.1",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
