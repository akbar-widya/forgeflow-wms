# ===== Better Auth (shared by API Worker and Web app) =====
# Server-side secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Public base URL of the API Worker (no trailing slash)
BETTER_AUTH_URL=http://localhost:8788

# ===== API Worker =====
ENVIRONMENT=development

# Comma-separated list of allowed browser origins (CSRF whitelist)
TRUSTED_ORIGINS=http://localhost:5173

# ===== Web app =====
# Public URL of the API Worker consumed by the browser
VITE_API_URL=http://localhost:8788
